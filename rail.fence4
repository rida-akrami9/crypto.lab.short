WRITE A JAVA PROGRAM TO PERFORM ENCRYPTION AND DECRYPTION USING RAIL FENCE
TRANSPOSITION TECHNIQUE.
Program
import java.util.*;
class RailFenceCipher {
    static String encrypt(String s, int r) {
        StringBuilder[] a = new StringBuilder[r];
        for (int i = 0; i < r; i++) a[i] = new StringBuilder();
        int row = 0, d = 1;
        for (char c : s.toCharArray()) {
            a[row].append(c);
            if (row == 0) d = 1; else if (row == r - 1) d = -1;
            row += d;
        }
        StringBuilder e = new StringBuilder();
        for (StringBuilder x : a) e.append(x);
        return e.toString();
    }
    static String decrypt(String s, int r) {
        int n = s.length(), row = 0, d = 1, k = 0;
        char[][] f = new char[r][n];
        for (int i = 0; i < n; i++) {
            f[row][i] = '*';
            if (row == 0) d = 1; else if (row == r - 1) d = -1;
            row += d;
        }
        for (int i = 0; i < r; i++)
        for (int j = 0; j < n; j++)
        if (f[i][j] == '*') f[i][j] = s.charAt(k++);
        StringBuilder p = new StringBuilder();
        row = 0; d = 1;
        for (int i = 0; i < n; i++) {
            p.append(f[row][i]);
            if (row == 0) d = 1; else if (row == r - 1) d = -1;
            row += d;
        }
        return p.toString();
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Text: ");
        String s = sc.nextLine();
        System.out.print("Rails: ");
        int r = sc.nextInt();
        String e = encrypt(s, r);
        System.out.println("Encrypted: " + e);
        System.out.println("Decrypted: " + decrypt(e, r));
    }
}
