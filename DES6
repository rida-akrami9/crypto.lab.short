Program
import javax.crypto.*;
import javax.crypto.spec.*;
import java.util.*;
class DESWithUserKey {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Plaintext: ");
        String s = sc.nextLine();
        System.out.print("Enter Key (must be 8 chars e.g. 12345678): ");
        String k = sc.nextLine();
        SecretKey key = SecretKeyFactory.getInstance("DES")
            .generateSecret(new DESKeySpec(k.getBytes()));
        Cipher c = Cipher.getInstance("DES/ECB/PKCS5Padding");
        c.init(Cipher.ENCRYPT_MODE, key);
        String e = Base64.getEncoder()
            .encodeToString(c.doFinal(s.getBytes()));
        System.out.println("Encrypted: " + e);
        c.init(Cipher.DECRYPT_MODE, key);
        System.out.println("Decrypted: "
            + new String(c.doFinal(Base64.getDecoder().decode(e))));
    }
}
